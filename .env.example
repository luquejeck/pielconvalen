# Numero de WhatsApp del consultorio (solo digitos, con codigo de pais)
NEXT_PUBLIC_WHATSAPP=5491122943672

# --- Supabase ---
# Sin estas dos variables la web funciona igual, con agenda simulada.
# Se sacan de: Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direccion publica del sitio. Sirve para la vista previa de WhatsApp,
# el sitemap y el robots.txt. En Vercel se completa sola; ponerla solo
# si hay dominio propio.
NEXT_PUBLIC_SITIO_URL=

# --- Clave de servicio (SOLO para scripts de mantenimiento) ---
# Se saltea el RLS: lee y escribe TODAS las tablas sin restriccion.
#
# Supabase -> Project Settings -> API Keys -> service_role
#
# NUNCA con prefijo NEXT_PUBLIC_: con ese prefijo viaja al navegador de
# cualquier visitante. La web no la usa ni la tiene que usar; sigue
# andando con la clave publica y el RLS.
SUPABASE_SERVICE_ROLE_KEY=
